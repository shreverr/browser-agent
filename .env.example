# Copy to .env and fill in. The agent calls models through OpenRouter.
OPENROUTER_API_KEY=sk-or-...

# Optional overrides
# HEADLESS=true                          # run the browser without a visible window
# AGENT_VISION=0                         # disable screenshots (vision is ON by default)
# AGENT_MODEL=anthropic/claude-opus-4.8  # any OpenRouter model slug; must support tool calling AND
#                                        #   vision/images while AGENT_VISION is on (default)
# AGENT_CHECKER_MODEL=google/gemini-2.5-flash  # cheaper model for the supervisor
# AGENT_MAX_STEPS=50
# AGENT_CHECK_EVERY=10                    # how often (in steps) the supervisor reviews progress
# AGENT_DEBUG_TOKENS=1                    # print per-step prompt/completion token usage
# AGENT_BROWSER_EXECUTABLE=/path/to/chrome # explicit installed Chrome/Chromium binary
# AGENT_STATE_ROOT=.profile/state          # encrypted checkpoints + redacted artifacts
# AGENT_STATE_ENCRYPTION_KEY=<base64>       # optional 32-byte key; local key otherwise
# AGENT_MEMORY_FILE=.profile/memory.json  # persistent user facts the agent may write
#
# Safety guardrails (deterministic, enforced in code):
# AGENT_ALLOWED_DOMAINS=amazon.in,flipkart.com   # restrict navigation to these domains (empty = any)
# AGENT_CONFIRM_KEYWORDS=place order,pay now,delete  # actions needing human "yes" before running
#                                        #   (defaults cover pay/place-order/delete/transfer)

# ---------------------------------------------------------------------------
# Error-analysis annotation server (browser_agent/evals/annotate, `uv sync --extra annotate`).
# Server-side values live in Render's environment, never in the repo. See its README.md.
# ANNOTATE_BASE_URL=https://browser-agent-annotate.onrender.com   # public URL (OAuth callback = +/auth/callback)
# ANNOTATE_DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/annotate?sslmode=require
# ANNOTATE_S3_ENDPOINT_URL=https://<account id>.r2.cloudflarestorage.com
# ANNOTATE_S3_BUCKET=browser-agent-traces
# ANNOTATE_S3_ACCESS_KEY_ID=...
# ANNOTATE_S3_SECRET_ACCESS_KEY=...
# ANNOTATE_S3_REGION=auto
# ANNOTATE_GITHUB_CLIENT_ID=...
# ANNOTATE_GITHUB_CLIENT_SECRET=...
# ANNOTATE_ALLOWED_GITHUB=alice,bob                # comma-separated GitHub logins
# ANNOTATE_SESSION_SECRET=<random, 32+ chars>      # signs the session cookie
# ANNOTATE_COOKIE_SECURE=true                      # false only for plain-http local dev
# ANNOTATE_BLOB_REDIRECT=false                     # true: 302 blobs to short-lived presigned R2 URLs
# ANNOTATE_MAX_UPLOAD_BYTES=67108864
# ANNOTATE_DEV_LOGIN=                              # local only: skip GitHub, sign in as this login
#
# Both the server and the capture machine (upload / export / propose CLI):
# ANNOTATE_UPLOAD_TOKEN=<random, 24+ chars>
# Capture machine only:
# ANNOTATE_URL=https://browser-agent-annotate.onrender.com
