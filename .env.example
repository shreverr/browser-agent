# Copy to .env and fill in. The agent calls models through OpenRouter.
OPENROUTER_API_KEY=sk-or-...

# Optional overrides
# HEADLESS=true                          # run the browser without a visible window
# AGENT_VISION=0                         # disable screenshots (vision is ON by default)
# AGENT_MODEL=anthropic/claude-opus-4.8  # any OpenRouter model slug; must support tool calling AND
#                                        #   vision/images while AGENT_VISION is on (default)
# AGENT_CHECKER_MODEL=google/gemini-2.5-flash  # cheaper model for the supervisor
# AGENT_MAX_STEPS=50
# AGENT_CHECK_EVERY=10                    # how often (in steps) the supervisor reviews progress
# AGENT_DEBUG_TOKENS=1                    # print per-step prompt/completion token usage
# CAMOUFOX_INSTALL_DIR=/path/to/camoufox  # override where the Camoufox binary is stored
# AGENT_STATE_FILE=.profile/state.json    # cookies/localStorage carried across runs
# AGENT_MEMORY_FILE=.profile/memory.json  # persistent user facts the agent may write
#
# Safety guardrails (deterministic, enforced in code):
# AGENT_ALLOWED_DOMAINS=amazon.in,flipkart.com   # restrict navigation to these domains (empty = any)
# AGENT_CONFIRM_KEYWORDS=place order,pay now,delete  # actions needing human "yes" before running
#                                        #   (defaults cover pay/place-order/delete/transfer)
